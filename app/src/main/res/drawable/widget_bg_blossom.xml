<?xml version="1.0" encoding="utf-8"?>
<!--
  小组件玻璃底的**樱花粉**版本。

  和 widget_bg.xml 只差两个渐变色：色相 +128°（212° → 340°），明度饱和度不动。
  所以"玻璃有多厚、亮边多亮"完全一致，变的只是它属于哪种天气——
  和应用里 BlossomLight 的做法是同一条规则。

  亮边仍然是 #CCFFFFFF：白色没有色相，不需要跟着转。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="270"
                android:endColor="#F8DCE5"
                android:startColor="#FFF7FA" />
            <stroke
                android:width="1dp"
                android:color="#CCFFFFFF" />
        </shape>
    </item>
</layer-list>
